# Solver readout with the impulse bars up, reached from a file instead of a
# click-through.
#
#   cargo run -p polytope_playground -- \
#     --script=crates/polytope_playground/console-scripts/impulse-bars.script
#
# Lines are `<frame> <console command>`, frame indices never decreasing;
# blank lines and lines starting with `#` are ignored. The run exits on its
# own a settling margin after the last line.
#
# The driver's timeline is frame-indexed, but the scene it drives is not: the
# demo integrates on a wall-clock dt, so a moving body does not reproduce
# byte-for-byte across runs. A pixel-identity comparison wants a script that
# leaves the scene still.

# Strip the frame down to the bodies and the overlay.
0 floor off
0 surface off

# All four overlay layers at once, then longer impulse bars than the default
# so one contact reads at a glance.
1 physics
1 physics impulse-scale 0.12

# Aim the rotation controls at the tesseract, then flick it into its
# neighbour so the solver has an impulse to draw.
2 select 1
6 throw 1 -160 -110

# `capture frames` is the honest tap: one lossless PNG per rendered frame,
# with no encoder backpressure to drop any of them.
8 capture frames post ./captures/impulse-bars
188 capture stop
