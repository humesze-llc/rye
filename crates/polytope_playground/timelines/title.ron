// POLYTOPE PLAYGROUND materializing out of w, one body per letter, left to
// right across both lines. Compiled into the binary by `crate::title`, so it
// plays in the browser too; edit it and rebuild.
//
// Every key writes w and nothing else. A letter's place in R³ is the
// typesetting's, so the loader refuses a key with a nonzero x, y or z rather
// than letting a file move a letter sideways behind the layout's back.
//
// w = 1.2 puts the slice exactly on the apex of the letter's 4D solid, where
// the cross-section is a point; w = -0.3 parks it in the solid's prism
// section, where the cross-section is the whole letter. Both numbers are read
// against `title::APEX_DEPTH` and `title::HOLD_DEPTH` by test, so a solid
// reshaped without retiming this file fails rather than half-appearing.
//
// The 0.1 s stagger and the 1.0 s transit are the only taste knobs here; a
// flat title is every letter on the same two key times.
(
    fps: 60,
    frames: 181,
    bodies: [
        // P
        (name: "letter0", position: Some([
            (t: 0.0, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 1.0, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // O
        (name: "letter1", position: Some([
            (t: 0.1, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 1.1, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // L
        (name: "letter2", position: Some([
            (t: 0.2, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 1.2, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // Y
        (name: "letter3", position: Some([
            (t: 0.3, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 1.3, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // T
        (name: "letter4", position: Some([
            (t: 0.4, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 1.4, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // O
        (name: "letter5", position: Some([
            (t: 0.5, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 1.5, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // P
        (name: "letter6", position: Some([
            (t: 0.6, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 1.6, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // E
        (name: "letter7", position: Some([
            (t: 0.7, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 1.7, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // P
        (name: "letter8", position: Some([
            (t: 0.8, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 1.8, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // L
        (name: "letter9", position: Some([
            (t: 0.9, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 1.9, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // A
        (name: "letter10", position: Some([
            (t: 1.0, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 2.0, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // Y
        (name: "letter11", position: Some([
            (t: 1.1, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 2.1, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // G
        (name: "letter12", position: Some([
            (t: 1.2, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 2.2, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // R
        (name: "letter13", position: Some([
            (t: 1.3, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 2.3, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // O
        (name: "letter14", position: Some([
            (t: 1.4, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 2.4, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // U
        (name: "letter15", position: Some([
            (t: 1.5, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 2.5, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // N
        (name: "letter16", position: Some([
            (t: 1.6, value: (0.0, 0.0, 0.0, 1.2)),
            (t: 2.6, value: (0.0, 0.0, 0.0, -0.3), ease: OutCubic),
        ])),
        // D
